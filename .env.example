# Optional live generation. Retrieval and dry-mode evaluation run without keys.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest

# Reference pipeline controls
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# The default MiniLM revision is pinned in config.py. Set this for another model.
EMBEDDING_REVISION=
TOP_K=3
MIN_SCORE=0.30
# Optional. Leave empty for an in-memory index rebuilt by each command.
VECTOR_STORAGE_PATH=
